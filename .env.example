# Copy to ~/.config/murmur/.env (the menu's "Open .env" creates it for you).
# Leave everything empty to stay fully local and offline (whisper.cpp, no cleanup).

# Whisper API for transcription when transcription.engine is "auto", "groq" or "openai",
# and chat model for cleanup when cleanup.provider is "auto", "groq" or "openai".
GROQ_API_KEY=
OPENAI_API_KEY=

# Cleanup only (cleanup.provider "auto" or "anthropic").
ANTHROPIC_API_KEY=

# Only for cleanup.provider "custom", if your OpenAI-compatible server wants a key.
CLEANUP_API_KEY=
